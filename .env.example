# Shared Supabase project used for uwdatascience.ca SSO
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Base URL of the main site, used to build the login redirect.
NEXT_PUBLIC_MAIN_SITE_URL=https://uwdatascience.ca

# Cookie domain the shared Supabase session is scoped to. Leave unset for
# localhost dev (browsers reject a Domain attribute on dotless hostnames).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.uwdatascience.ca
